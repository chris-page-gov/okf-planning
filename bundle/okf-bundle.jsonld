    {
      "@id": "https://chris-page-gov.github.io/okg-planning/dataset/building-preservation-notice",
      "@type": "Dataset",
      "identifier": "planning:building-preservation-notice",
      "title": "Building preservation notice",
      "description": "Local planning authorities can serve a Building Preservation Notice (BPN) on a building owner if they consider a building\nis in danger of demolition or alteration in a way that might affect its special character.\nBPN's take effect immediately, protecting the building for a limited time period, as if it were listed.\n\nThe local planning authority must make an application to [Historic England](https://historicengland.org.uk/)\nto list the building at the same time that the BPN is served.\n\nWe expect to develop a data specification to help LPAs to publish their building preservation notices to supplement this data from Historic England.",
      "landingPage": "https://www.planning.data.gov.uk/dataset/building-preservation-notice",
      "sourcePublisher": [
        "https://www.planning.data.gov.uk/"
      ],
