  "publication": {
    "mode": "automatic-protected-main",
    "scope": "bounded-demonstrator",
    "authority": {
      "decision": "Protected main publishes the frozen draft snapshot after core and browser acceptance. An owner-authorised formal release freezes only the exact public-verified candidate under docs/publication-method.md.",
      "evidence_paths": [
        "README.md",
        "bundle/data/governance/release.json",
        "docs/publication-method.md"
      ]
    },
    "candidate_policy": "promote-exact-assured-bytes-without-rebuild",
    "targets": [
      {
        "id": "github-pages",
        "kind": "github-pages",
        "workflow_path": ".github/workflows/pages.yml",
        "public_base_url": "https://chris-page-gov.github.io/okf-planning/",
        "exact_commit_required": true,
        "promote_without_rebuild": true
      },
      {
        "id": "github-release",
        "kind": "github-release",
        "workflow_path": ".github/workflows/pages.yml",
        "exact_commit_required": true,
        "promote_without_rebuild": true,
        "public_base_url": "https://github.com/chris-page-gov/okf-planning/releases/"
      }
    ]
  },
  "verification": {
    "required": true,
    "browser": "real-browser",
    "exact_commit_required": true,
    "identity_checks": [
      "commit",
      "descriptor",
      "snapshot",
      "sha256",
      "record-count",
      "route"
    ],
    "journeys": [
      {
        "id": "design-code-question-desktop",
        "url": "https://chris-page-gov.github.io/okf-planning/walkthrough.html",
        "expected_identity": "Design code in the frozen 230-record planning metadata bundle",
        "steps": [
          "Read the question, source dates, inferred links and limits.",
          "Follow the actual Reader link, open Details and expand Overview to see the original source card and draft lifecycle.",
          "Follow the inferred graph link to the NPPF record.",
          "Reload and retain the same record and source."
        ]
      },
      {
        "id": "design-code-question-mobile",
        "url": "https://chris-page-gov.github.io/okf-planning/walkthrough.html",
        "expected_identity": "Design code in the frozen 230-record planning metadata bundle",
        "steps": [
          "Read the question, source dates, inferred links and limits.",
          "Follow the actual Reader link, open Details and expand Overview to see the original source card and draft lifecycle.",
          "Follow the inferred graph link to the NPPF record.",
          "Reload and retain the same record and source."
        ]
      }
    ],
    "console_policy": "no-errors",
    "command_ids": [
      "check-browser",
      "verify-pages"
    ]
  },
  "limitations": [
    "The source snapshot remains 25 July 2026 and the 25 October 2026 review boundary is overdue; format migration did not refresh source material.",
    "The custom domain profile retains 40 inferred collection-rule links. No Bundle Wiki assertion profile, official legal application, proposal compliance or source endorsement is claimed.",
    "The core checksum file covers core generator outputs; the separate packaging manifest binds every served file, authored UI and companion to the exact candidate commit.",
    "Formal acceptance requires separate exact public browser receipts and release read-back; a configured workflow or green local test does not establish publication acceptance.",
    "Declared commands are untrusted data and must be reviewed against guidance and code before execution."
  ]
}
